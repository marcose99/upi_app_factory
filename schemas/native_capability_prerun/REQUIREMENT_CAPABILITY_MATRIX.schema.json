{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REQUIREMENT_CAPABILITY_MATRIX",
  "type": "object",
  "required": ["schema_version", "artifact", "application_id", "requirements_sha256", "items", "decision"],
  "properties": {
    "schema_version": {"const": "native-capability-prerun.v1"},
    "artifact": {"const": "REQUIREMENT_CAPABILITY_MATRIX"},
    "application_id": {"type": "string"},
    "requirements_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requirements": {"type": "array", "minItems": 1},
    "items": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
