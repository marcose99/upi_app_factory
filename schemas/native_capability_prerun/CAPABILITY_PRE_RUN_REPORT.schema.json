{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAPABILITY_PRE_RUN_REPORT",
  "type": "object",
  "required": ["schema_version", "artifact", "application_id", "requirements_sha256", "status", "decision", "mandatory_gate_passed", "obligations"],
  "properties": {
    "schema_version": {"const": "native-capability-prerun.v1"},
    "artifact": {"const": "CAPABILITY_PRE_RUN_REPORT"},
    "application_id": {"type": "string"},
    "requirements_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["PROVEN_100_PERCENT_CAPABILITY", "NO_GO_WITH_IMPROVEMENT_REQUIREMENTS"]},
    "decision": {"enum": ["PROVEN_100_PERCENT_CAPABILITY", "NO_GO_WITH_IMPROVEMENT_REQUIREMENTS"]},
    "mandatory_gate_passed": {"type": "boolean"},
    "obligations": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
