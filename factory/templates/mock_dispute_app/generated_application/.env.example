UPI_DISPUTE_APP_ENV=local
UPI_DISPUTE_EXTERNAL_ECOSYSTEM_MODE=mock
UPI_DISPUTE_ENABLE_LIVE_PROVIDER_CALLS=false
UPI_DISPUTE_ALLOW_REAL_SECRETS=false
UPI_DISPUTE_LOCAL_HOST=127.0.0.1
UPI_DISPUTE_LOCAL_PORT=8042
UPI_DISPUTE_DATA_DIR=var/local_runtime
UPI_DISPUTE_SQLITE_PATH=var/local_runtime/disputes.sqlite3
UPI_DISPUTE_AUDIT_LOG_PATH=var/local_runtime/audit_events.jsonl
