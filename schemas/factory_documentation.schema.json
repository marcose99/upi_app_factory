{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UPI App Factory Complete Documentation Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at_utc",
    "html_sha256",
    "source_files",
    "technical_inventory",
    "reduced_motion_policy",
    "animations",
    "diagrams",
    "claim_evidence",
    "unresolved_claims",
    "truth_boundaries",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "upi-app-factory.factory-documentation.v1"},
    "generated_at_utc": {"const": "1970-01-01T00:00:00Z"},
    "html_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_files": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": ["path", "source_kind", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "source_kind": {"const": "tracked_file"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "source_traceability": {"type": "array"},
    "reduced_motion_policy": {
      "type": "object",
      "required": ["css_media_query", "html_marker", "behavior", "animated_classes"],
      "properties": {
        "css_media_query": {"const": "@media (prefers-reduced-motion: reduce)"},
        "html_marker": {"const": "data-reduced-motion-policy"},
        "behavior": {"type": "string", "minLength": 1},
        "animated_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "technical_inventory": {
      "type": "object",
      "required": ["controls_traced", "routes_traced", "verified_claims_ingested", "source_files_traced", "source_route_declarations", "source_ui_controls", "required_topics"],
      "properties": {
        "controls_traced": {"type": "integer", "minimum": 1},
        "routes_traced": {"type": "integer", "minimum": 1},
        "verified_claims_ingested": {"type": "integer", "minimum": 1},
        "source_files_traced": {"type": "integer", "minimum": 20},
        "source_route_declarations": {"type": "integer", "minimum": 60},
        "source_ui_controls": {"type": "integer", "minimum": 37},
        "required_topics": {"const": 22}
      }
    },
    "source_fact_inventory": {
      "type": "object",
      "required": ["route_declarations", "ui_controls"],
      "properties": {
        "route_declarations": {
          "type": "array",
          "minItems": 60,
          "items": {
            "type": "object",
            "required": ["method", "route", "source_path"],
            "properties": {
              "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
              "route": {"type": "string", "minLength": 1},
              "source_path": {"type": "string", "minLength": 1}
            }
          }
        },
        "ui_controls": {"type": "array", "minItems": 37, "items": {"type": "string", "minLength": 1}}
      }
    },
    "animations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "purpose", "mechanism", "reduced_motion", "source_claim_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "reduced_motion": {"type": "string", "minLength": 1},
          "source_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "diagrams": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "title", "purpose", "source_claim_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "source_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "claim_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "section", "statement", "sources"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "section": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "source_kind", "sha256", "locator", "observation"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "source_kind": {"const": "tracked_file"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "locator": {"type": "string", "minLength": 1},
                "observation": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "unresolved_claims": {"type": "array", "maxItems": 0},
    "truth_boundaries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "ui_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "debug_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "controls_traced": {"type": "integer", "minimum": 1},
    "routes_traced": {"type": "integer", "minimum": 1}
  }
}
