{
  "$id": "https://upi-app-factory.local/schemas/lifecycle/lifecycle-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "approvals": {
      "type": "object"
    },
    "completed_states": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "current_state": {
      "minLength": 1,
      "type": "string"
    },
    "llm_calls": {
      "const": 0
    },
    "manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "phase": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "phase",
    "status",
    "current_state",
    "completed_states",
    "manifest_digest",
    "approvals",
    "llm_calls"
  ],
  "title": "UPI App Factory Lifecycle Run",
  "type": "object"
}
