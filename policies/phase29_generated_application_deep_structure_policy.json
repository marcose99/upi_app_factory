{
  "policy_id": "phase29_generated_application_deep_structure_policy",
  "version": "1.0.0",
  "phase": "phase29_generated_application_deep_structure_generator",
  "status": "active",
  "scope": "future generated UPI dispute resolution applications emitted by the factory generation layer",
  "mandatory_gate": "PHASE29-GA-DEEP-STRUCTURE-GENERATOR-GATE",
  "phase28_blueprint_required_as_generator_input": true,
  "required_before_generation_success": true,
  "required_generator": "factory/generators/mock_dispute_app_generator.py",
  "required_template_manifest": "factory/templates/mock_dispute_app/template_manifest.v1.json",
  "required_prompt": "prompts/phase29/generated_application_deep_structure_prompt.md",
  "required_phase28_inputs": [
    "factory_governance/generated_application_architecture_depth/phase28_architecture_depth_blueprint.v1.json",
    "policies/phase28_generated_application_architecture_depth_policy.json",
    "prompts/phase28/generated_application_architecture_depth_prompt.md"
  ],
  "required_capabilities": [
    "real locally runnable primary UPI dispute resolution application",
    "mocked or simulated external UPI rails, NPCI/RBI interfaces, banks, PSPs, merchants, notifications, and ecosystem integrations",
    "explicit domain entities and value objects",
    "explicit dispute lifecycle state machine",
    "application service layer",
    "repository and unit-of-work abstractions",
    "SQLite-first local persistence with migration discipline",
    "idempotency store",
    "audit trail",
    "outbox or domain event model",
    "API contract schemas",
    "structured error handling",
    "PII redaction",
    "input validation",
    "structured logging, metrics, and tracing-ready hooks",
    "unit, integration, contract, negative, resilience, security, and performance-smoke test obligations"
  ],
  "certification_boundary": "certification_ready_not_certified",
  "official_certification_claimed": false,
  "official_certification_granted": false,
  "live_provider_calls_allowed": false,
  "external_ecosystem_integrations": "mocked_or_simulated_only",
  "real_secrets_allowed": false,
  "deployment_allowed": false,
  "human_approval_required_for": [
    "risky self-evolution",
    "destructive actions",
    "merge",
    "tag",
    "release",
    "promotion",
    "live provider calls",
    "certification-related claims"
  ],
  "prohibited_without_separate_human_approval": [
    "live provider calls",
    "real NPCI/RBI/bank/PSP/payment rail integration",
    "real secrets or credentials",
    "destructive generated-application overwrite",
    "merge",
    "tag",
    "release",
    "promotion",
    "official certification claim"
  ]
}
