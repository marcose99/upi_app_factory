{
  "schema_version": "human-approved-promotion-certification-boundary-policy.v1",
  "policy_id": "phase14c.human_approved_promotion_certification_boundary_policy",
  "app_id": "upi_dispute_resolution",
  "mode": "HUMAN_APPROVED_PROMOTION_GATE_AND_CERTIFICATION_READY_BOUNDARY",
  "preferred_term": "application engineering",
  "requires_phase13az_autonomy_control_plane": true,
  "requires_phase14a_lifecycle_plan_executor": true,
  "requires_phase14b_sandbox_loop": true,
  "factory_does_not_self_certify": true,
  "certification_ready_not_certified": true,
  "official_certification_boundary_required": true,
  "certification_authority_verification_required": true,
  "promotion_requires_human_approval": true,
  "automatic_promotion_allowed": false,
  "real_generated_application_delete_allowed": false,
  "real_generated_application_overwrite_allowed_without_approval": false,
  "arbitrary_shell_execution_allowed": false,
  "live_provider_calls_allowed": false,
  "external_system_calls_allowed": false,
  "factory_self_modification_allowed": false,
  "auto_merge_allowed": false,
  "auto_tag_allowed": false,
  "auto_release_allowed": false,
  "boundary_between_generated_application_and_certification": [
    "certifying_authority_review",
    "independent_verification",
    "formal_audit_or_compliance_assessment",
    "regulatory_or_industry_standard_assessment",
    "production_environment_validation_where_required",
    "security_privacy_resilience_and_operational_review",
    "official_certification_decision"
  ],
  "required_certification_evidence": [
    "requirement_traceability",
    "architecture_and_design_evidence",
    "policy_decision_records",
    "sandbox_generation_evidence",
    "local_validation_reports",
    "security_and_governance_validation_reports",
    "mock_boundary_evidence",
    "rollback_and_replay_evidence",
    "handover_evidence",
    "known_limitations_and_certification_boundary_statement"
  ],
  "policy_rule": "Phase 14C may build a human-approved promotion gate and certification-ready evidence boundary, but it must not claim official certification. Final certification remains with authorized certifying authorities after independent review, audit, production-environment validation where required, and official certification decision."
}
