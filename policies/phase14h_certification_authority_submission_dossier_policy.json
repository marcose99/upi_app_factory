{
  "schema_version": "certification-authority-submission-dossier-policy.v1",
  "policy_id": "phase14h.certification_authority_submission_dossier_policy",
  "app_id": "upi_dispute_resolution",
  "mode": "CERTIFICATION_AUTHORITY_SUBMISSION_DOSSIER",
  "preferred_term": "application engineering",
  "requires_phase14d_evidence_pack": true,
  "requires_phase14e_fresh_recipient_replay_pack": true,
  "requires_phase14f_review_workspace": true,
  "requires_phase14g_findings_remediation_loop": true,
  "factory_does_not_self_certify": true,
  "certification_ready_not_certified": true,
  "official_certification_claimed": false,
  "official_certification_granted_by_factory": false,
  "certification_authority_verification_required": true,
  "official_certification_decision_required": true,
  "submission_dossier_only": true,
  "release_execution_allowed": false,
  "real_generated_application_delete_allowed": false,
  "real_generated_application_overwrite_allowed_without_approval": false,
  "arbitrary_shell_execution_allowed": false,
  "live_provider_calls_allowed": false,
  "external_system_calls_allowed": false,
  "factory_self_modification_allowed": false,
  "auto_merge_allowed": false,
  "auto_tag_allowed": false,
  "auto_release_allowed": false,
  "required_dossier_sections": [
    "submission_cover",
    "application_identity",
    "certification_boundary_statement",
    "evidence_inventory",
    "fresh_recipient_replay_summary",
    "authority_review_workspace_summary",
    "findings_remediation_summary",
    "production_environment_validation_checklist",
    "official_decision_placeholder",
    "factory_non_certification_attestation"
