{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upi-app-factory.local/schemas/phase68_70/evidence_integrity.schema.json",
  "title": "Phase 68-70 Evidence Integrity",
  "type": "object",
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^[^/].*" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
