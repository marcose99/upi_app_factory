{
  "$id": "https://upi-app-factory.local/schemas/lifecycle/repair-catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "max_repair_attempts_per_phase": {
      "maximum": 3,
      "minimum": 0,
      "type": "integer"
    },
    "phase": {
      "const": "46G"
    },
    "repairs": {
      "items": {
        "required": [
          "repair_id",
          "risk",
          "automatic"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "ACTIVE"
    }
  },
  "required": [
    "schema_version",
    "phase",
    "status",
    "max_repair_attempts_per_phase",
    "repairs"
  ],
  "type": "object"
}
