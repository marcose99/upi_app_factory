{
  "schema_version": "governed-self-healing-repair-catalog-policy.v1",
  "policy_id": "phase13ar.governed_self_healing_repair_catalog_policy",
  "app_id": "upi_dispute_resolution",
  "mode": "LOCAL_ONLY_REPAIR_CATALOG_NON_DESTRUCTIVE",
