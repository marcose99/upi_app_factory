{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UPI App Factory control-plane campaign manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "metadata",
    "baseline",
    "objective",
    "scope",
    "budgets",
    "approvals",
    "activities"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "campaign_id": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" },
    "baseline": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "required": ["allowed_write_paths"],
      "properties": {
        "allowed_write_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budgets": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 10000 } },
    "approvals": { "type": "object" },
    "validation_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_prerequisites", "deterministic_runtime_noise"],
      "properties": {
        "trusted_prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "path", "hydrate"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["file", "directory"] },
              "path": { "type": "string", "minLength": 1 },
              "hydrate": { "type": "boolean" }
            }
          }
        },
        "deterministic_runtime_noise": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "path"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["file", "directory"] },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "kind",
          "risk",
          "argv",
          "dependencies",
          "target_state",
          "timeout_seconds",
          "cwd",
          "environment_allowlist",
          "allowed_write_paths"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["execution", "verification", "checkpoint"] },
          "risk": { "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"] },
          "argv": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "target_state": {
            "enum": [
              "NEW",
              "INTAKE_VALIDATED",
              "RISK_CLASSIFIED",
              "PLAN_APPROVED_BY_POLICY",
              "WORKSPACE_READY",
              "ENGINEERING",
              "OFFLINE_VALIDATED",
              "OPTIONAL_LIVE_EVALUATED",
              "CANDIDATE_SEALED",
              "PR_OPEN",
              "HOSTED_CHECKS_PASSED",
              "MERGED",
              "POSTMERGE_ACCEPTED",
              "HANDOFF_BUILT",
              "CLEANED",
              "CLOSED"
            ]
          },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
          "cwd": { "type": "string" },
          "environment_allowlist": { "type": "array", "items": { "type": "string" } },
          "allowed_write_paths": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
