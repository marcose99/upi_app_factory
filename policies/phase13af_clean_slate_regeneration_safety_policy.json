{
  "schema_version": "clean-slate-regeneration-safety-policy.v1",
  "policy_id": "phase13af.clean_slate_regeneration_safety_policy",
  "app_id": "upi_dispute_resolution",
  "mode": "LOCAL_ONLY_DRY_RUN_DELETE_GUARD",
  "live_provider_calls_allowed": false,
  "external_system_calls_allowed": false,
  "destructive_delete_allowed_in_this_phase": false,
  "human_approval_required_before_delete": true,
  "human_approval_required_before_regeneration": true,
  "backup_required_before_delete": true,
  "audit_required": true,
  "allowed_delete_targets": [
    "workspace/factory_generated/upi_dispute_resolution/generated_application"
  ],
  "blocked_delete_targets": [
    ".git",
    ".venv",
    "docs",
    "policies",
    "scripts",
    "tests",
    "factory_governance",
    "workspace/factory_generated/upi_dispute_resolution/lifecycle_artifacts",
    "workspace/factory_generated/upi_dispute_resolution/release_handoff",
    "/",
    "~"
  ],
  "required_pre_delete_controls": [
    "dry_run_delete_plan",
    "target_path_boundary_check",
    "symlink_rejection",
    "backup_plan",
    "evidence_preservation_plan",
    "human_approval_token_future_phase_only"
  ],
  "required_post_delete_controls": [
    "target_absent_or_empty_check",
    "evidence_preserved_check",
    "audit_record_written",
    "regeneration_gate_ready_check"
  ],
  "clean_slate_regeneration_readiness_rule": "The factory may not delete generated_application for clean-slate regeneration until a future phase adds explicit destructive approval workflow and passes this safety guard."
}
