{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:upi-app-factory:transformation:finding:v1",
  "title": "Transformation Finding",
  "type": "object",
  "required": ["finding_id", "category", "classification", "path", "line"],
  "properties": {
    "finding_id": {"type": "string"},
    "category": {"type": "string"},
    "classification": {"type": "string"},
    "path": {"type": "string"},
    "line": {"type": "integer", "minimum": 1},
    "matched_text": {"type": "string"},
    "context": {"type": "string"},
    "rule_id": {"type": "string"}
  },
  "additionalProperties": false
}
