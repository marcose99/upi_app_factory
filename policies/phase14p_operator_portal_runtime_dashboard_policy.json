{
  "schema_version": "operator-portal-runtime-dashboard-proof-policy.v1",
  "policy_id": "phase14p.operator_portal_runtime_dashboard_policy",
  "app_id": "upi_dispute_resolution",
  "mode": "OPERATOR_PORTAL_RUNTIME_DASHBOARD_PROOF",
  "preferred_term": "application engineering",
  "requires_phase14l_operator_portal_certification_dashboard": true,
  "requires_phase14o_actual_clean_checkout_replay_proof": true,
  "portal_runtime_probe_required": true,
  "operator_visible_status_must_be_not_certified": true,
  "external_ecosystem_integrations_remain_mock": true,
  "factory_does_not_self_certify": true,
  "certification_ready_not_certified": true,
  "official_certification_claimed": false,
  "official_certification_granted_by_factory": false,
  "release_execution_allowed": false,
  "human_approval_required_for_release_candidate_declaration": true,
  "human_approval_required_for_promotion": true,
  "human_approval_required_for_merge": true,
  "human_approval_required_for_tag": true,
  "human_approval_required_for_release": true,
  "real_generated_application_delete_allowed": false,
  "real_generated_application_overwrite_allowed_without_approval": false,
  "arbitrary_shell_execution_allowed": false,
  "live_provider_calls_allowed": false,
  "external_system_calls_allowed": false,
  "factory_self_modification_without_policy_allowed": false,
  "auto_merge_allowed": false,
  "auto_tag_allowed": false,
  "auto_release_allowed": false,
  "required_runtime_routes": [
    "/dashboards/certification-readiness",
    "/api/dashboards/certification-readiness",
    "/api/certification-readiness",
    "/health"
  ],
  "required_operator_wording": [
    "Certification-ready, not certified.",
    "Factory does not self-certify.",
    "Official certification decision remains with authorized certifying authorities.",
    "External ecosystem integrations remain mock or simulated."
  ],
  "policy_rule": "Phase 14P must prove operator-facing certification-readiness dashboard behavior at runtime. It must show not-certified wording, preserve the mock ecosystem boundary, and avoid release, self-certification, certification claims, live calls, external calls, and destructive generated-app mutation."
}
