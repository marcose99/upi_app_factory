{
  "schema_version": "certification-ready-release-candidate-evidence-policy.v1",
  "policy_id": "phase14d.certification_ready_release_candidate_evidence_policy",
  "app_id": "upi_dispute_resolution",
  "mode": "CERTIFICATION_READY_RELEASE_CANDIDATE_EVIDENCE_PACK",
  "preferred_term": "application engineering",
  "requires_phase14c_certification_boundary": true,
  "factory_does_not_self_certify": true,
  "certification_ready_not_certified": true,
  "official_certification_claimed": false,
  "release_execution_allowed": false,
  "release_candidate_pack_only": true,
  "certification_authority_verification_required": true,
  "official_certification_decision_required": true,
  "automatic_promotion_allowed": false,
  "real_generated_application_delete_allowed": false,
  "real_generated_application_overwrite_allowed_without_approval": false,
  "arbitrary_shell_execution_allowed": false,
  "live_provider_calls_allowed": false,
  "external_system_calls_allowed": false,
  "factory_self_modification_allowed": false,
  "auto_merge_allowed": false,
  "auto_tag_allowed": false,
  "auto_release_allowed": false,
  "boundary_between_generated_application_and_certification": [
    "certifying_authority_review",
    "independent_verification",
    "formal_audit_or_compliance_assessment",
    "regulatory_or_industry_standard_assessment",
    "production_environment_validation_where_required",
    "security_privacy_resilience_and_operational_review",
    "official_certification_decision"
