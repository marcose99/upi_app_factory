{
  "schema_version": "governed-autonomy-control-plane-policy.v1",
  "policy_id": "phase13az.governed_autonomy_control_plane_policy",
  "app_id": "upi_dispute_resolution",
  "mode": "GOVERNED_A_TO_Z_AUTONOMY_CONTROL_PLANE_POLICY_ONLY",
  "preferred_term": "application engineering",
  "requires_phase13ay_operator_dashboards": true,
  "control_plane_only": true,
  "autonomy_target": "A_TO_Z_LIFECYCLE_UNDER_POLICY_GATES",
  "maximum_default_autonomy_level": 4,
  "release_gates_require_human_approval": true,
  "worktree_mutation_requires_human_approval": true,
  "live_provider_calls_allowed_by_default": false,
  "external_system_calls_allowed_by_default": false,
  "arbitrary_shell_execution_allowed": false,
  "destructive_delete_allowed": false,
  "real_generated_application_overwrite_allowed_without_approval": false,
  "factory_self_modification_allowed_without_approval": false,
  "auto_merge_allowed": false,
  "auto_tag_allowed": false,
  "auto_release_allowed": false,
  "required_control_families": [
    "risk_tiered_action_catalog",
    "autonomy_level_matrix",
    "human_approval_boundary_matrix",
    "sandbox_first_execution",
    "evidence_required_per_action",
    "rollback_required_for_mutation",
    "provider_and_external_call_gates",
    "release_gate_protection",
    "blocked_action_catalog",
    "audit_replayability"
  ],
  "autonomy_levels": [
    "LEVEL_0_MANUAL",
    "LEVEL_1_GUIDED",
    "LEVEL_2_READ_ONLY_VALIDATION",
    "LEVEL_3_SANDBOX_AUTONOMOUS",
    "LEVEL_4_HUMAN_GATED_WORKTREE_AUTONOMOUS",
    "LEVEL_5_RELEASE_GATED_AUTONOMOUS",
    "LEVEL_6_ENTERPRISE_AUTONOMOUS_REFERENCE"
  ],
  "blocked_actions": [
    "ARBITRARY_SHELL_COMMAND",
    "DELETE_REAL_GENERATED_APPLICATION",
    "OVERWRITE_REAL_GENERATED_APPLICATION_WITHOUT_APPROVAL",
    "MUTATE_FACTORY_WITHOUT_POLICY_DECISION",
    "CALL_LIVE_PROVIDER_WITHOUT_GATE",
    "CALL_EXTERNAL_SYSTEM_WITHOUT_GATE",
    "MERGE_WITHOUT_HUMAN_APPROVAL",
    "TAG_WITHOUT_HUMAN_APPROVAL",
    "RELEASE_WITHOUT_HUMAN_APPROVAL",
    "BYPASS_EVIDENCE_CAPTURE",
    "BYPASS_VALIDATION_GATES"
  ],
  "policy_rule": "Phase 13AZ defines the governed A-to-Z autonomy control plane. It may decide whether a lifecycle action is approved, blocked, or human-gated, but it must not itself mutate the real worktree, run generation, call live providers, call external systems, merge, tag, or release."
}
