{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UPI App Factory control-plane policy decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "action", "risk", "outcome", "human_required", "policy_digest", "reasons"],
  "properties": {
    "decision_id": { "type": "string", "minLength": 64, "maxLength": 64 },
    "action": { "type": "string" },
    "risk": { "type": "string" },
    "outcome": { "enum": ["allow", "pause", "deny"] },
    "human_required": { "type": "boolean" },
    "policy_digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "reasons": { "type": "array", "items": { "type": "string" } }
  }
}
