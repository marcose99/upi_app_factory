{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UPI App Factory Complete Documentation Manifest",
  "type": "object",
  "required": ["schema_version", "html_sha256", "source_traceability", "ui_manifest_sha256", "debug_plan_sha256", "controls_traced", "routes_traced", "diagrams"],
  "properties": {
    "schema_version": {"const": "upi-app-factory.factory-documentation.v1"},
    "html_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_traceability": {"type": "array"},
    "ui_manifest_sha256": {"type": "string"},
    "debug_plan_sha256": {"type": "string"},
    "controls_traced": {"type": "integer", "minimum": 1},
    "routes_traced": {"type": "integer", "minimum": 1},
    "diagrams": {"type": "array", "minItems": 5}
  }
}
