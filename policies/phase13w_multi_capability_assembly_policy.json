{
  "policy_id": "POL-13W-GOVERNED-MULTI-CAPABILITY-ASSEMBLY",
  "policy_version": "1.0.0",
  "intent": "Govern generated multi-capability local application assembly while preserving mock external ecosystem boundaries.",
  "allowed_capability_count_min": 2,
  "allowed_capability_count_max": 4,
  "required_capabilities": [
    "evidence_validation",
    "sla_triage"
  ],
  "allowed_generated_roots": [
    "workspace/factory_generated/upi_dispute_resolution/generated_application/phase13w_multi_capability_dispute_app",
    "workspace/factory_generated/upi_dispute_resolution/lifecycle_artifacts/phase13w"
  ],
  "forbidden_targets": [
    ".venv",
    ".git",
    "secrets",
    "production_external_integrations",
    "real_bank_or_n pci_interfaces"
  ],
  "requires_human_release_approval": true,
  "requires_traceability": true,
  "requires_generated_tests": true,
  "requires_mock_external_boundary": true,
  "llm_runtime_mode": "deterministic_local",
  "openai_api_key_required": false,
  "future_llm_mode": {
    "provider_config_env": "FACTORY_LLM_PROVIDER",
    "model_config_env": "FACTORY_LLM_MODEL",
    "secret_config_env": "OPENAI_API_KEY",
    "secret_storage_rule": "Secrets must be injected externally and must never be committed."
  }
}
